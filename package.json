  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^22.15.32",
    "drizzle-kit": "^0.31.1",
    "svelte-check": "^4.2.1",
    "tsx": "^4.20.3",
